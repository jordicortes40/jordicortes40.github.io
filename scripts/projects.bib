@MISC{31305019,
title = {Dynamic evaluation of COVID-19 clinical states and their prognostic factors to improve the intra-hospital patient management},
year = {2021-05-14},
abstract = {Background: In COVID-19 studies, modeling the disease course regarding serious events and identifying prognostic factors is of great clinical relevance. Previous studies to predict high-risk critically ill cases among patients with a diagnosis of COVID-19 have not yet arrived at a solid conclusion because of being poorly reported and at high risk of bias not offering clear recommendations for use in current practice. Furthermore, although death is the final and most severe endpoint, there are other clinically intermediate events such as acute respiratory distress, intensive unit care (ICU) admission, or afterward relapse that are relevant to themselves and for clinical management. The integrated combination of all these events through statistical multi-state models are required to learn about the progress of a COVID-19 patient.
Objectives: First, to identify the most clinically relevant prognostic factors for respiratory distress, UCI admission, death, or discharge in a cohort of hospitalized adult subjects with confirmed COVID-19. Second, to develop a reliable clinical prediction tool for the early identification of potentially high-risk individuals among COVID-19 patients using multi-state model analysis. Third, to estimate the incubation time period of the COVID-19, for the first time, in a Catalan cohort with data from a potential third wave pandemic in our country. Fourth, to assess the evolution of the disease and the patients’ profile over time.

Methods: Data will come from a multicenter multi-cohort study of consecutive hospitalized adult patients in 8 hospitals in the Regió Metropolitana Sud with confirmed COVID-19 in three different periods that will be approximately: March 1st-May 31st, 2020; October 1st-December 31st, 2020 and March 1st-May 31st 2021. We anticipate that the three cohorts together will have about 6,000 patients hospitalized for COVID-19. A pool of prognostic factors from the patients' medical records would be chosen for its clinical relevance shown in previous studies. The death risk due to COVID-19 with or without respiratory distress and other relevant clinical prognostic factors will be determined using a non-Markovian multi-state model with five states: In ward without respiratory distress, in ward with respiratory distress, ICU stay, hospital discharge, and death. Data from the second cohort will be used to validate the multi-state model from the first cohort. The incubation period will be estimated from the third cohort, and taking into account the periods of exposure to the infection as well as the date of symptoms onset. The patient’s profile and assessment of the behavior of some relevant indicators will be analysed using clustering techniques. 

Expected results: The developed multi-state model, within the projected R shiny app, will provide an informative tool that will help clinicians to early identify patients at a higher risk of developing acute respiratory distress syndrome and death and will hopefully reduce unnecessary ICU admissions. Preliminary findings, expectedly available before a plausible third wave in Spring 2021, will be fundamental to detect high-risk COVID-19 patients and provide them with adequate treatment at an early stage. Knowing the COVID-19 incubation period and its associated factors might allow personalizing the quarantine durations. The statistical framework used in this project will be susceptible to being applied in future pandemics with a similar disease course.},
category = {National Project},
}

@MISC{28881326,
keywords = {eficiencia relativa asintótica;ensayos de bioequivalencia;anotaciones biológicas;ensayos clínicos;análisis integrativo de datos ómicos;censura por intervalo;modelos multiestado;estadística multivariante;análisis de supervivencia;asymptotic relative efficiency;bioequivalence trials;biological annotations;clinical trials;integrative analysis;interval censoring;multistate models;multivariate statistics;omics data;survival analysis},
title = {Statistical methodologies for clinical and omics data and their applications in health sciences},
year = {2020-06-01},
abstract = {The proposal Statistical methodologies for clinical and omics data and their applications in Health Sciences aims to contribute to the advance of methodologies in survival analysis, clinical trials, multi-omics data and the integrative analysis of clinical and omics data. The development of free tools for the user is also a priority of this project. We will continue to strengthen our interdisciplinary collaborations with our colleagues in Fight AIDS Foundation, AIDS Research Institute, Vall dHebron Research Institute, among others. Through these collaborations, our results will materialize in biostatistical and bioinformatics solutions to relevant problems in the following areas: HIVAIDS, Cancer, Neuroscience and Sport Sciences. This directly addresses the priorities established in RETO 1: Health, Demographic change and Welfare.
We consider methodological advances for time-to-event data. A series of results are foreseen, spanning from fundamental research on foundations of interval-censoring (IC) through more applied research like the estimation of the survival function for left-truncated and right-censored times when the onset is IC; development of goodness-of-fit procedures and tools for IC data; study of bidirectional multistate models; tests combining survival and binary data taking into account the potential correlation between them; extension of the metric, Life Years Lost, to account for time-varying conditions and to accommodate potential confounders.
We will continue our research on composite endpoints developing new formulas to calculate the sample size when the hazards are not proportional, adding new features to our multitask tool named CompARE and proposing a novel ARE measure to allow the comparison of the efficiency of potential trial designs. A very important issue for the pharmaceutical industry is planning a bioequivalence trial (BE). We aim to develop a new approach to type I error control in scaling methods for BE for Highly Variable Drugs and under wide classes of bioequivalence adaptive designs. We are committed as well to measure the heterogeneity in Randomized Clinical Trials aiming to improve reporting guidelines. New methods for mediation analysis will be developed to account for the non-linearity of the proportional hazards model.
We investigate how to extend results for incomplete matrix and tensor factorization to data with a block-wise missing structure, where some sources are unobserved for certain groups of samples. We extend our previous results on the analysis of gene lists to other distances and other ontologies. This will be applied to derive new methods to match and merge multi-omics datasets using biological annotations. Deep learning will be used to integrate radiological images from the GTEx project by first discovering cross-correlations from data and then building a histopathological signature at the image level. Methods for the analysis of microbiome data will be derived by adapting methods such as kernel machine regression and penalized regression to the compositional data analysis representation. A platform for multimodal data management and analysis will be built to manage different types of data and to analyze them using workflows -in Galaxy - combining standard software with what has been developed in this project.},
category = {National Project},
}

@MISC{23363351,
keywords = {acute ischemic stroke;neurophysiological monitoring;somatosensory evoked potential;mechanical
thrombectomy;biomarkers;outcome;diagnosis},
title = {FUNDACIÓ MARATÓ TV3 - Nous biomarcadors predictius de recuperació funcional òptima i de bona resposta al tractament endovascular de l’ictus isquèmic agut. Estudi PrOMISE (somatosensory evoked POtEntials MonItoring during acute ischemic StrokE)},
year = {2017-01-01},
abstract = {Endovascular treatment in patients with acute ischemic stroke due to large vessel occlusion does not always lead to good clinical and functional outcome, despite achieving complete arterial recanalization. The rate of significant functional disability or death after three months of an acute ischemic stroke still ranges from 40% to 67%. There is experimental and clinical evidence that somatosensory evoked potentials (SEPs) are good indicators of cerebral blood flow.

The primary objective of this study is to determine the sensitivity and specificity of N20 response of SEPs prior to mechanical thrombectomy (MT) as a predictor of functional independence at 90 days after endovascular treatment. Secondly, we will study whether SEPs may be neurophysiological markers of brain tissue in ischemic penumbra and optimal collateral circulation.

Bilateral median nerve SEPs will be recorded before and continuously during MT in patients with acute ischemic stroke and anterior large vessel occlusion. N20 response ipsilateral to the cerebral hemisphere affected will be measured (qualitatively and quantitatively). The adjusted predictive value of the N20 biomarker on functional independence after MT will be analyzed by binary logistic regression and its predictive value on the full range of disability by ordinal logistic regression. We will construct different regression models with other clinical predictors available at the prehospital setting and with those determined after hospital admission to determine the independent predictive power of the N20 response for a potential treatment decision-making. Finally, we will study whether SEP can be neurophysiological markers ischemic penumbra tissue and optimal collateral circulation through its correlation with multimodal neuroimaging techniques.

SEPs recording is non-invasive technique that can be performed at the bedside of the patient. The development of a portable device which could allow SEPs recording by sanitary staff (pre- and intrahospitalary) would provide early data about N20 value, speeding up streamline decision making.},
category = {National Project},
}

@MISC{23362049,
keywords = {Anàlisi integrativa;Anàlisi Multivariant de Dades;Aplicacions web;Bioinformàtica;Bioequivalència;Clinical trials;Dades Òmiques;Simulation;Survival analysis},
title = {Grup de recerca en bioestadística i bioinformàtica},
year = {2017-01-01},
abstract = {El GRBIO és un grup interdisciplinari amb interessos diversos tant metodològics com aplicats amb una base comuna que és l'aplicació rigorosa de l'estadística a problemes suscitats a les Ciències de la Vida i de la Salut. Les activitats científiques les agrupem en tres àmbits: 
1) Assajos clínics: aportacions metodològiques en les fases de disseny i modelat estadístic; 
2) Anàlisi integrativa de dades òmiques: mètodes estadístics multivariants i de "machine learning"; 
3) Desenvolupament d'eines estadístiques i informàtiques per l'explotació dels resultats de la recerca biomèdica. 
Mencionem també les contribucions a l'anàlisi i representació de dades multivariants, a l'anàlisi de dades de supervivència amb censura en un interval, a l'optimització del disseny de fàrmacs amb simulació i a la resolució de problemes aplicats en camps com VIH/SIDA, oncologia, neurociències, cardiologia o immunologia.},
category = {National Project},
}

@MISC{17980136,
keywords = {eficiencia relativa asintótica. ensayos de bioequivalencia;anotaciones biológicas;ensayos clínicos;análisis integrativo de datos ómicos;censura por intervalo;modelos multiestado;estadistica multivariante;análisis de supervivència;asymptotic relative efficiency;bioequivalence trials;biological annotations;clinical trials;integrative analysis;interval censoring;multistate models;multivariate statistics;omics data;survival analysis},
title = {Statistical methods for clinical trials, complex censoring schemes and integrative omics data analysis},
year = {2016-01-01},
abstract = {The aim of this project is to contribute to the advance on statistical methodologies in survival ana1ysis, clinical trials and integrative analysis of omics data. These three main areas are well related to each other. they not only share a common methodological background but 
coincide, often, in the area where they are applied. While omics technologies are the basis for biomarker díscovery and validation, clinical trials are used to investigate the effect of drugs whose action can be rneasured by the previously derived biomarkers and sorne of the 
methods in survival analysis form par1 of the core methods to analyze clinical trials. 
With respect to ciinical trials, this subproject will consolidate a theory based on the relative efficiency to decide on the best primary 
variable. This methodology will be used to address the computation of the sample size when the proportionality of the risks functions is not met. An online platform will be developed to guide clinicians in the decision. A very importan! issue for the pharmaceutical industry is 
planning a bioequlvalence trial; new proposals in this project are addressed. 
Methodological advances for discrete survival data and with interval-censored data to extend the existing class of hypothesis tests and 
providlng new goodness-of-fit methods will be sought. Their application to veterinary studies and to predict the shelf-life of foods will be an outcome of interest. Advances to integrate multistate models, landmark analysis and to incorporate special features of the data such as interval censoring and competing rsks are part of the innovations that we look for. 
Deriving biomarkers with high sensitivity and high specificity is a difficult endeavor. To increase the information on which they are built 
combining different types of data is a task addressed in thls subproject. We will approach differenl multivariate methods for this type of 
integration. Dimension reduction methods applied simultaneously to several, probably incomplete, dataseis will be obtained. Kernel 
methods for variable representation in reduced dimension will also be derived. Biological annotatlons will be taken as the basis for 
matching datasets with common and non-common individuals so that "virtually complete" dataseis can be obtained to apply the analyses on them. This will improve the possibility for analyzing complex datasets merging different types of omics data. accounting for their 
biological interpretabllity -through the use of annotations-and allowing to obtain more sensible biomarkers. System-biology studies where the different levels on which biological processes take place (genome, transcriptome. proteome, etc.) will be simultaneously analyzed 
yielding a much better view of the systems than that could be obtained separately. 
Most of the ideas leading to our new methods and procedures have been motivated by our close and long standing relationship with 
colleagues in severa! research institutions (The Flght against AIDS Foundation, Unidad de Patologla Vascular Cerebral del Hospital Clinic de Barcelona, Van dHebron lnstitut de Recerca, among others). 11 is of utrnost importance for us to enhance this relationship by providing solutions that taclde the right question and give a good solution. In line with this intention, a great ernphasis wil'I be given not only to 
implementing !he methods developed but also in building user friendly interfaces to be accessible to a wide range of biomedical 
researchers.},
category = {National Project},
}

