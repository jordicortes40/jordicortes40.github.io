@MISC{42955109,
keywords = {Análisis estadístico;Aprendizaje automático;Inteligencia artificial;Rendimiento deportivo;Sports Analytics.},
title = {Red de Investigación en Sports Analytics},
year = {2025-01-01},
abstract = {Esta red se presenta para dar un impulso inicial y cohesionar varios grupos de universidad españolas que vienen realizando investigación en analítica deportiva aplicada al rendimiento deportivo y otros campos. Estos grupos han empezado a cohesionarse y a proponer actividades de manera conjunta. Para el año 2025, se propone el desarrollo de un curso de verano sobre analítica deportiva, una sesión temática en el congreso nacional más importante de estadística así como un workshop sobre inteligencia artificial aplicada a analítica deportiva.

La red también proseguirá con las laborares de divulgación y transferencia, como desarrollo metodológico y de software libre. Así, se propone también la creación de vídeos divulgativos donde integrantes de la red expongan diversas herramientas de analítica deportiva y aplicaciones en analítica deportiva.},
url = {https://www.infosubvenciones.es/bdnstrans/GE/es/convocatorias/819774},
category = {National Project},
}

@MISC{39692056,
keywords = {Análisis de supervivencia;Ensayos clínicos;Modelización estadística;Software de código abierto;Modelos multiestado;Censura en un intervalo;Datos sintéticos;Modelos predictivos;Resultados comunicados por los pacientes;Bioestadística;Survival analysis;Clinical trials;Statistical Modelling;Open-source Software;Multi-state Models;Interval Censoring;Synthetic Data;Predictive Models;Patient-reported Outcomes;Sports biostatistics},
title = {Statistics for Health Sciences: Advances in Survival Analysis and Clinical Trials},
year = {2024-09-01},
abstract = {The project proposal titled "Statistics for Health Sciences: Advances in Survival Analysis, Clinical Trials, and Statistical Modelling (SAFARI)aims to make important contributions to the methodological progress in Survival Analysis, Clinical Trials, and Statistical Modelling. In addition, the development of free user-friendly open-source software tools is also a priority of this project. To achieve these goals, our research teams in Catalunya and Euskadi have joined forces to present this coordinated project. Building upon our close collaboration that started several years ago, we are committed to reinforcing this collaboration and to strengthening our interdisciplinary collaboration with professionals in health research centers such as BioBizkaia and hospitals like the Galdakao-Usansolo Hospital and the Bellvitge University Hospital.
Our research in Survival Analysis encompasses two large areas: multi-state models (MSM) and interval censoring (IC). Regarding MSM, our methodological investigations are concentrated on second-order Markov models, as well as on the accommodation of intervalcensored transition times. In the field of applied research, we will extend and enhance the Shiny app MSMpred. Moreover, we aim to develop and validate a robust clinical prediction tool designed to identify individuals at high-risk for infections due to respiratory pathogens.
With respect to IC, we anticipate various results including the development of goodness-of-fit techniques for interval-censored data and their integration into the R package GofCens; sample size computation for studies with interval-censored response variables; and methodological advancements in the study of regression models with interval-censored covariates including the development of model diagnostics specifically designed for generalized linear models with interval-censored covariates and the parameter estimation of time-toevent models with such covariates.
In our research on Clinical Trials, amongst other things, we anticipate the development of sequential testing and estimation methods for adaptive group-sequential trials. These methods will be designed to accommodate varying allocation ratios and handle non-concurrent data efficiently. Additionally, our efforts include the extension and adaptation of the R package CompAREdesigns to cover more complex trial designs, and the development of a simulation tool for crossover trial design data. This tool will be characterized by its modularity, allowing for versatility across different trial designs and distributions.
Among our research in Statistical Modelling, we highlight the following goals and expected results: development of a prediction model for chronic diseases; proposal of a joint model of mean and dispersion parameters in beta-binomial regression models specifically designed for patient-reported outcomes; development of a Bayesian model for the joint analysis of longitudinal beta-binomial outcomes and time until death; and a substantial enhancement of the PROreg R package integrating the implementation of the aforementioned models. We will also address the parameter estimation of beta-binomial regression models with complex survey data, the application of dynamic prediction for recurrent events, the integration of machine-learning techniques and statistical modelling for the generation of synthetic data, and the enhancement of methodologies for longitudinal analysis in pharmaceutical clinical studies.},
category = {National Project},
}

@MISC{37841273,
keywords = {Stroke;RACE scale;machine learning;artificial intelligence;endovascular therapy},
title = {RACE Plus: AI-driven application to allow pre-hospital diagnosis and management of stroke patients},
year = {2024-01-01},
abstract = {Stroke is a highly prevalent disease that affects 15 million people worldwide each year. 40 % of cases are caused by an occlusion in one of the major arteries of the brain and can be effectively treated with endovascular therapy. However, this therapy is only available in a few highly specialised hospitals with experienced staff. It is estimated that half of the patients are initially transferred to centres that lack the skills to carry out this therapy, which can result in significant delays in treatment, unnecessary health care costs and worse patient outcomes. On the other hand, 25 % of strokes are haemorrhagic in nature, and in these cases the earliest possible care at the nearest hospital is needed, where measures to reduce the bleeding can be initiated.

In all cases of stroke, response time is crucial and the chances of neural tissue recovery depend on an agile and precise response in its characterisation and treatment. Artificial intelligence applied in the pre-hospital ambulance setting can be a key tool to identify the type of stroke and the treatment needed by each patient. It can thus facilitate individualised decisions that enhance and optimise the process of transfer management.

The stroke severity assessment tools currently available in the pre-hospital setting, such as the RACE scale, previously developed by the research group and implemented globally, are based on clinical scales that grade the severity of symptoms, but have limited diagnostic capabilities. This project proposes the development of RACE-Plus, a new application aimed at the pre-hospital environment (ambulances) that will use artificial intelligence algorithms to predict the type of stroke a patient is experiencing in order to direct them immediately to the health centre that will ensure the best clinical recovery. The researchers estimate that the correct categorisation of patients and their consequent transfer to the appropriate hospital could increase access to endovascular therapy by up to 20 % and advance treatment by two hours, leading to a 10 % increase in chances of recovery.},
url = {https://caixaresearch.org/ca/convocatoria-caixaimpulse-innovacio-salut-2023-projecte-ia-categoritzar-ictus},
category = {National Project},
}

@MISC{34939242,
keywords = {HealthTech;Digital Health;IVD;Medtech;tecnologies de la salut;intel·ligència artificial;big data;eSalut;biomaterials;instrumentació;sensors;imatge mèdica;robòtica mèdica;radiofísica mèdica;biomecànica;simulació;serious games;gamificació},
title = {Xarxa R+D+I en Tecnologies de la Salut (Xartec Salut)},
year = {2023-01-01},
abstract = {La Xartec Salut té l’objectiu de convertir-se en la XARXA R+D+I DE REFERÈNCIA EN EL SECTOR DE LES TECNOLOGIES DE LA SALUT. Amb 81 grups de recerca de 25 institucions, es centra en els següents objectius específics: 
1) Impulsar la VALORITZACIÓ i la TRANSFERÈNCIA de les innovacions en el sector HealthTech. 
2) Generar SINERGIES entre els grups de recerca per MULTIPLICAR EL SEU POTENCIAL i desenvolupar solucions disruptives que sorgeixin de les necessitats mèdiques i de la indústria, posant el PACIENT al centre. 
3) Crear un ECOSISTEMA singular de SPIN-OFFs en salut en l’àrea catalana i CONNECTAR-lo amb la resta d’agents del sistema. 
4) Ser un pol d’atracció de TALENT, i contagiar l’ESPERIT EMPRENEDOR i el interès per la transferència tecnològica en els estudiants pre i post doctorals. 
5) Dinamitzar el teixit empresarial i mobilitzar capital privat, afavorint la col¿laboració amb la INDÚSTRIA i l’apropament als INVERSORS. 
Ens visualitzem com un PONT QUE CONNECTA EL TALENT AMB EL MERCAT. A una banda comptem amb el sistema universitari, les seves escoles de doctorat i els investigadors dels grups de recerca. A l’altre extrem hi tenim una gran xarxa d’actors propers a mercat (emprenedors, empreses, administracions, clústers i inversors) i als usuaris de les tecnologies (metges i pacients). Al mig hem construït EINES EFICIENTS PER ACOMPANYAR els investigadors al llarg de TOT EL PROCÉS D'INNOVACIÓ de forma estandaritzada, des de que sorgeix la idea fins que aquesta arriba al mercat. Centrarem tots els nostres esforços en aconseguir que la recerca tingui un IMPACTE SOCIAL I ECONÒMIC REAL. 
Durant la 1a edició de Xartec Salut, ens hem focalitzat especialment en la creació d’empreses SPINOFF i en el disseny de processos que ens han permès CATALITZAR LA VALORITZACIÓ I LA TRANSFERÈNCIA de les tecnologies. A la 2a edició, pretenem completar les nostres activitats i ENFOCAR-NOS en 3 necessitats claus detectades en el procés de transferència tecnològica, després de llançar alguns pilots que ens han permès avaluar la importància de focalitzar-nos en: 
¿ POTENCIAR EL TALENT INNOVADOR. Hem vist que existeix una gran demanda de perfils altament qualificats que tinguin una doble vessant (tant científica com de negoci), per tal de possibilitar que els resultats de la recerca es converteixin en productes i serveis. És per això que veiem essencial impulsar un CANVI CULTURAL per fomentar l’ESPERIT EMPRENEDOR i innovador entre els joves científics. La Xartec Salut ha fet una prova pilot molt exitosa amb l’escola de doctorat de la UPC (l’Entrepreneurship Academy). Es llançarà un 2n programa interuniversitari que involucrarà la participació activa de les escoles de doctorat de les universitats de la Xarxa que s’hi vulguin adherir (comptem amb 9 universitats i algunes com al URV, ja han expressat gran interès). 
¿ AFAVORIR una INNOVACIÓ CENTRADA EN EL PACIENT. És essencial desenvolupar tecnologies que estiguin alineades amb les necessitats reals dels pacients i del mercat. S’ha inclòs nous hospitals i centres d’atenció primària a la Xarxa per involucrar als usuaris finals en la co-creació de les innovacions. També comptem amb el Col¿legi Oficial de Metges de Barcelona (a través de Meditecnología) com a entitat adherida a la Xarxa. Es desenvoluparan noves activitats com el "Patient Connect Tour". 
¿ COL¿LABORAR MÉS ESTRETAMENT AMB EL SECTOR EMPRESARIAL I INVERSOR. Amb aquest fi s’han establert converses inicials amb clústers empresarials i múltiples empreses del sector Medtech i Pharma. Algunes com AstraZeneca ja han aportat reptes pel nostre 1r Hackató i s’han compromès a participar activament en el gran esdeveniment HealthTech2030 (que es celebrarà el 10/11/2022). A part de comptar amb els possibles compradors de les tecnologies, també estem teixint relacions amb inversors. Volem involucrar-los perquè actuïn com a mentors dels projectes, donant-los la visió del que busca el mercat. I al mateix temps, perquè ells puguin fer un seguiment primerenc dels projectes i del seu desenvolupament. 
Aquesta proposta s’assenta sobre la base dels gairebé 2 anys d’activitat de Xartec Salut (veure apartat c2.2 - indicadors aconseguits), el que ens ha permès validar les necessitats dels grups, del procés de techtransfer i alinear els nostres objectius amb les institucions participants, per maximitzar el impacte. No només, gairebé tots els grups de recerca continuen a la Xarxa (cal dir que alguns s’han fusionat, degut a la nova convocatòria SGR), sinó que hi ha hagut un increment percentual del 72% de nous grups que s’hi volen adherir.},
category = {Research Network},
}

